// Prisma Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
}

// Hace base de datos donde definimos las tablas y relaciones
// No tocar package - lock.json NI POR NADA DEL MUNDO 

enum EstadoEquipo {
  BUENO
  EN_REPARACION
  INHABILITADO
}

enum TipoEquipo {
  CAMARA
  TRIPODE
  MICROFONO
  PANEL_SONIDO
  CABLE
  PANEL_SWITCH
  OTRO
}

model Equipo {
  id           String       @id @default(uuid())
  codigo       String       @unique @default(cuid())
  nombre       String
  modelo       String
  anio         Int?
  precioCompra Decimal      @db.Decimal(12, 0)
  tipo         TipoEquipo
  descripcion  String?
  estado       EstadoEquipo @default(BUENO)
  archivadoAt  DateTime?

  kitId        String?
  kit          Kit?               @relation(fields: [kitId], references: [id], onDelete: SetNull)
  reparaciones ReparacionEquipo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nombre])
  @@index([tipo])
  @@index([kitId])
  @@index([estado])
}

model Kit {
  id          String  @id @default(uuid())
  nombre      String
  descripcion String?

  equipos Equipo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReparacionEquipo {
  id          String    @id @default(uuid())
  equipoId    String
  equipo      Equipo    @relation(fields: [equipoId], references: [id], onDelete: Restrict)
  fechaInicio DateTime
  fechaFin    DateTime?
  costo       Decimal?  @db.Decimal(12, 0)
  descripcion String?

  @@index([equipoId, fechaInicio])
}

// ==========================================================
// FINANZAS (Danae)
// ==========================================================

// ES SIMULADA
model Transmision {
  id     String   @id @default(uuid())
  nombre String   @db.VarChar(150)
  fecha  DateTime @db.Date

  gastos       Gasto[]
  auspicios    Auspicio[]
  asignaciones Asignacion[]

  @@index([fecha])
}

model Gasto {
  id          String   @id @default(uuid())
  tipo        String   @db.VarChar(100)
  descripcion String   @db.VarChar(255)
  valor       Decimal  @db.Decimal(12, 0)
  fecha       DateTime @default(now()) @db.Date
  comprobante String?  @db.VarChar(255)

  transmisionId String?
  transmision   Transmision? @relation(fields: [transmisionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fecha])
  @@index([transmisionId])
}

// ES SIMULADA
enum TipoAuspicio {
  MONETARIO
  CANJE
}

// ES SIMULADA
model Auspicio {
  id    String       @id @default(uuid())
  marca String       @db.VarChar(150)
  tipo  TipoAuspicio
  valor Decimal      @db.Decimal(12, 0)

  transmisionId String
  transmision   Transmision @relation(fields: [transmisionId], references: [id], onDelete: Restrict)

  @@index([transmisionId])
}

// ES SIMULADA
enum TipoCargo {
  CAMAROGRAFO
  SONIDISTA
  DIRECTOR
  PRODUCTOR
  OTRO
}

// ES SIMULADA
model Trabajador {
  id     String @id @default(uuid())
  nombre String @db.VarChar(150)

  asignaciones Asignacion[]
}

// ES SIMULADA
model Asignacion {
  id    String    @id @default(uuid())
  cargo TipoCargo
  pago  Decimal   @db.Decimal(12, 0)

  trabajadorId String
  trabajador   Trabajador @relation(fields: [trabajadorId], references: [id], onDelete: Restrict)

  transmisionId String
  transmision   Transmision @relation(fields: [transmisionId], references: [id], onDelete: Restrict)

  @@unique([trabajadorId, transmisionId, cargo])
  @@index([transmisionId])
}
