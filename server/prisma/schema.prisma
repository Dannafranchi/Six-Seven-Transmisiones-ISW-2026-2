// Prisma Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
}

// Hace base de datos donde definimos las tablas y relaciones.
// No tocar package - lock.json NI POR NADA DEL MUNDO 

enum EstadoEquipo {
  BUENO
  EN_REPARACION
  INHABILITADO
}

enum TipoEquipo {
  CAMARA
  TRIPODE
  MICROFONO
  PANEL_SONIDO
  CABLE
  PANEL_SWITCH
  OTRO
}

model Equipo {
  id           String       @id @default(uuid())
  codigo       String       @unique @default(cuid())
  nombre       String
  modelo       String
  anio         Int?
  precioCompra Decimal      @db.Decimal(12, 0)
  tipo         TipoEquipo
  descripcion  String?
  estado       EstadoEquipo @default(BUENO)
  archivadoAt  DateTime?

  kitId        String?
  kit          Kit?               @relation(fields: [kitId], references: [id], onDelete: SetNull)
  reparaciones ReparacionEquipo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nombre])
  @@index([tipo])
  @@index([kitId])
  @@index([estado])
}

model Kit {
  id          String  @id @default(uuid())
  nombre      String
  descripcion String?

  equipos Equipo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReparacionEquipo {
  id          String    @id @default(uuid())
  equipoId    String
  equipo      Equipo    @relation(fields: [equipoId], references: [id], onDelete: Restrict)
  fechaInicio DateTime
  fechaFin    DateTime?
  costo       Decimal?  @db.Decimal(12, 0)
  descripcion String?

  @@index([equipoId, fechaInicio])
}